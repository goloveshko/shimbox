{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shimbox",
  "version": "0.1.0",
  "identifier": "dev.goloveshko.shimbox",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "shimbox",
        "width": 880,
        "height": 640,
        "minWidth": 620,
        "minHeight": 440
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
